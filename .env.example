# =====================================================================
# Lotus configuration - copy to .env and adjust. See README.md.
# .env is git/dockerignored. Never commit real secrets.
# =====================================================================

# --- Deployment profile -------------------------------------------------------
#   single      = one process, SQLite, local labs (laptop / single VM)
#   team        = Postgres compose, token + proof signing key required
#   enterprise  = Postgres, require LOTUS_AUTH_TOKEN, k8s overlay may HPA
LOTUS_DEPLOY_PROFILE=single

# Single-user Compose host HTTP port (1-65535); binds only to 127.0.0.1.
# The container listener and health check remain on 8000. Native Python uses
# uvicorn --port instead. Stop any other Lotus instance sharing ./data first.
LOTUS_HTTP_PORT=8000

# Shared-secret API lock. Required for team/enterprise profiles; empty is only
# acceptable for a single-user localhost deployment.
# Protected API calls accept Authorization: Bearer <token> or X-API-Key.
# The UI keeps the token in browser session storage (Settings > API Access).
# The UI switch does not disable server authentication.
# LOTUS_AUTH_TOKEN=
# When changing LOTUS_HTTP_PORT, update these explicit local origins to match.
# Preserve deliberately trusted additional origins; do not regenerate existing
# encryption/proof keys just to change the port. If omitted, single-user Compose
# derives its default local origins from LOTUS_HTTP_PORT.
LOTUS_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Database ----------------------------------------------------------------
# Single-user (SQLite): ONE Lotus instance and ONE API worker per data directory.
# The worker-count startup guard does not detect every separately launched instance.
DATABASE_URL=sqlite:////app/data/lotus.db
# Team/enterprise (Postgres): required for any multi-worker / multi-replica deployment.
# DATABASE_URL=postgresql://lotus:CHANGE_ME@db:5432/lotus
POSTGRES_USER=lotus
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lotus

# --- Secrets -----------------------------------------------------------------
# Used to encrypt credentials at rest. Generate: `openssl rand -hex 32`.
LOTUS_SECRET_KEY=

# --- AI providers (or set them in the Settings UI) ---------------------------
# Configure the provider you use; keys can also be entered/tested in the UI.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEVIN_API_KEY=
# OPENROUTER_API_KEY=
# Local model servers:
# OLLAMA_BASE_URL=http://localhost:11434
# LMSTUDIO_BASE_URL=http://localhost:1234

# --- Concurrency / performance ----------------------------------------------
LOTUS_MAX_CONCURRENT_SCANS=1
LOTUS_MAX_CONCURRENT_TOOLS=8
LOTUS_AI_CONCURRENCY=3

# --- Proof / labs ------------------------------------------------------------
# Keep the lab proof gate enabled; unproven leads are not confirmed findings.
LOTUS_REQUIRE_LAB_PROOF=1
# HMAC key for attested lab receipts (>=32 characters). Without it, PoCs remain
# investigative candidates and cannot become report-eligible.
LOTUS_PROOF_SIGNING_KEY=
# Set to 1 to disable all local lab validation, including Kubernetes and Docker.
# Runtime coverage remains unverified when labs are disabled.
# LOTUS_DISABLE_LAB=
LOTUS_LAB_BASE_IMAGE=lotus-lab-ubuntu:26.04
LOTUS_LAB_MEMORY=4g
LOTUS_LAB_CPUS=2
# Skip Joern CPG (faster; loses deep interprocedural taint).
# LOTUS_DISABLE_JOERN=1

# --- Fuzzing (C/Rust) --------------------------------------------------------
# LOTUS_FUZZING=1
LOTUS_FUZZ_TIMEOUT=300

# --- Data locations (mount these for durability) -----------------------------
LOTUS_REPOS_DIR=/app/data/repos
LOTUS_SKILLS_DIR=/app/data/skills
LOTUS_BACKUP_DIR=/app/data/backups
LOTUS_DATA_DIR=/app/data
# LOTUS_CREDENTIALS_PATH=/app/data/.lotus_credentials.json

# Gunicorn workers (ignored for single profile — forced to 1). Team/enterprise only.
# WEB_CONCURRENCY=2

# Break-glass: start even if deploy blockers fire (never in production).
# LOTUS_ALLOW_UNSAFE_DEPLOY=1

# Learned-skill cap and optional dense embeddings (off unless a model is present).
# LOTUS_MAX_LEARNED_SKILLS=800
# LOTUS_EMBEDDINGS=auto
# LOTUS_EMBED_MODEL=all-MiniLM-L6-v2
# LOTUS_EMBED_URL=

# Single-user Compose already enables the supplementary Docker socket group.
# Optional override; default 0 matches the Docker Desktop mounted socket.
# DOCKER_GID=0
# Linux: run stat -Lc '%g' /var/run/docker.sock and set DOCKER_GID to that number.
# Custom daemon / permission error: inspect the group inside the container:
# docker compose -f docker-compose.single.yml exec lotus stat -c '%g' /var/run/docker.sock
# Then set DOCKER_GID here and recreate the service:
# docker compose -f docker-compose.single.yml up -d --force-recreate lotus
# A macOS host socket symlink's GID may differ from the mounted socket's GID.
# Keep the app nonroot; preserve socket permissions rather than using chmod.

# Legacy Docker readiness requirement. Kubernetes does not require Docker CLI.
# LOTUS_REQUIRE_DOCKER=1

# Parallel high-yield discovery strategies (complexity-hotspot still runs last).
# LOTUS_DISCOVERY_WORKERS=4

# Kubernetes is the default runtime. Single-user Docker Compose explicitly
# selects Docker as a backup deployment. Team/enterprise Compose uses k8s-job;
# docker-compose.host-lab.yml explicitly selects a disposable Docker runner.
# LOTUS_RUNTIME takes precedence over the legacy LOTUS_LAB_PROVIDER alias.
# LOTUS_RUNTIME=k8s-job
# LOTUS_LAB_PROVIDER=k8s-job
# LOTUS_LAB_PROVIDER_STRICT=1
# LOTUS_ALLOW_PROVIDER_FALLBACK=1
# K8s proof runs require an OCI @sha256 digest. This is a local development
# break-glass only; it records a resolved digest but is not replay-stable.
# LOTUS_ALLOW_UNPINNED_K8S_IMAGE=0
# Shared/team profiles fail closed when Docker socket access is present unless
# this is explicitly acknowledged (prefer a Job-based isolated runner).
# LOTUS_ALLOW_HOST_DOCKER_SOCKET=0
# Repository Compose/Dockerfiles are untrusted; runtime policy is always applied.
# LOTUS_ALLOW_REPO_COMPOSE=1
# LOTUS_ALLOW_REPO_DOCKERFILE=1
# Notebook code execution is a privileged local-evaluation surface and is off by default.
# LOTUS_ENABLE_NOTEBOOK=1

# --- Notifications -----------------------------------------------------------
LOTUS_SLACK_CHANNEL=#lotus-channel

# --- Seed data ---------------------------------------------------------------
# Demo rows are disabled by default. Set LOTUS_SEED_DEMO=1 only for a showcase.
# LOTUS_SEED_DEMO=1
